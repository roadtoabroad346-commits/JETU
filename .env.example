# Optional for the Phase 04 informational page and liveness route.
# Configure BOTH public Supabase values before invoking any Supabase client.
# Use separate development/staging/production projects. Never commit actual keys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Modern sb_publishable_ key; a local legacy anon JWT is also supported.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only for an explicitly authorized server operation that must bypass RLS.
# Never prefix this variable with NEXT_PUBLIC_. No Phase 04 route uses it.
SUPABASE_SECRET_KEY=

# local | test for local database scripts. Staging/production are refused.
JETU_ENV=local
